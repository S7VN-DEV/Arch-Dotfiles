[global]
   
    ### Display ###

    follow = mouse
    sort = yes
    notification_limit = 5

    width = 250
    height = (0, 100)
    offset = (12, 12)
    origin = top-right

    gap_size = 5
    frame_width = 3
    corner_radius = 4
    progress_bar_corner_radius = 2

    frame_color = "{{colors.primary.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"

    ### Text ###
    
    font = JetBrainsMono Nerd Font Mono 11
    markup = full
    word_wrap = no
    show_indicators = false
    show_age_threshold = 5m
    format = "<b>%a</b>\n<b>%s</b>\n%b"

    ### Mouse ###

    # Left click
    mouse_left_click = close_current
    # Middle click
    mouse_middle_click = open_url, close_current
    # Right click
    mouse_right_click = do_action

[urgency_low]
    timeout = 2
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    highlight = "{{colors.primary_container.default.hex}}"

[urgency_normal]
    timeout = 5
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    highlight = "{{colors.primary_container.default.hex}}"

[urgency_critical]
    timeout = 0
    frame_color = "{{colors.error.default.hex}}"
    background = "{{colors.on_error.default.hex}}"
    foreground = "{{colors.error.default.hex}}"
    highlight = "{{colors.error.default.hex}}"    
